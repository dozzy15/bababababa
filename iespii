    Healthbar.BackgroundColor3 = ESP.Drawing.Healthbar.GradientRGB1
end

            if ESP.Drawing.Healthbar.HealthText then
                local healthPercentage = math.floor(health * 100)
                HealthText.Position = UDim2.new(0, Pos.X - w / 2 - 15, 0, Pos.Y - h / 2 + h * (1 - health) + 3)
                HealthText.Text = tostring(healthPercentage)
                HealthText.Visible = true

                if ESP.Drawing.Healthbar.Lerp then
                    HealthText.TextColor3 = health >= 0.75 and Color3.fromRGB(0, 255, 0)
                        or health >= 0.5 and Color3.fromRGB(255, 255, 0)
                        or health >= 0.25 and Color3.fromRGB(255, 170, 0)
                        or Color3.fromRGB(255, 0, 0)
                else
                    HealthText.TextColor3 = ESP.Drawing.Healthbar.HealthTextRGB
                end
            else
                HealthText.Visible = false
            end

            Name.Visible = ESP.Drawing.Names.Enabled
            Name.TextColor3 = ESP.Drawing.Names.RGB

            local prefix = ""
            if ESP.Options.Friendcheck and lplayer:IsFriendsWith(plr.UserId) then
                prefix = string.format('(<font color="rgb(%d,%d,%d)">F</font>) ',
                    ESP.Options.FriendcheckRGB.R * 255,
                    ESP.Options.FriendcheckRGB.G * 255,
                    ESP.Options.FriendcheckRGB.B * 255)
            else
                if ESP.ShowEnemyTag then
					prefix = '(<font color="rgb(255,0,0)">E</font>) '
                else
				    prefix = ""
				end
			end

            if ESP.Drawing.Distances.Enabled and ESP.Drawing.Distances.Position == "Text" then
                Name.Text = prefix .. plr.Name .. " [" .. math.floor(Dist) .. "]"
            else
                Name.Text = prefix .. plr.Name
            end
            Name.Position = UDim2.new(0, Pos.X, 0, Pos.Y - h / 2 - 11)

            if ESP.Drawing.Distances.Enabled and ESP.Drawing.Distances.Position == "Bottom" then
                Distance.Visible = true
                Distance.Text = math.floor(Dist) .. "m"
                Distance.TextColor3 = ESP.Drawing.Distances.RGB
                Distance.Position = UDim2.new(0, Pos.X, 0, Pos.Y + h / 2 + 8)
            else
                Distance.Visible = false
            end

            local tool = character:FindFirstChildOfClass("Tool")
            if tool then
                Weapon.Text = tool.Name
            else
                Weapon.Text = "none"
            end
            Weapon.Visible = ESP.Drawing.Weapons.Enabled
            Weapon.TextColor3 = ESP.Drawing.Weapons.WeaponTextRGB
            Weapon.Position = UDim2.new(0, Pos.X, 0, Pos.Y + h / 2 + (ESP.Drawing.Distances.Enabled and ESP.Drawing.Distances.Position == "Bottom" and 22 or 8))

            if ESP.Drawing.Flags.Enabled then
                Flag1.Visible = true
                Flag1.Text = plr.Team and plr.Team.Name or "No Team"
                Flag1.Position = UDim2.new(0, Pos.X + w / 2 + 4, 0, Pos.Y - h / 2 + 8)
                Flag1.TextColor3 = plr.Team and plr.Team.TeamColor.Color or Color3.fromRGB(255, 255, 255)
            else
                Flag1.Visible = false
            end
        end)
    end

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= lplayer then
            task.spawn(CreateESP, v)
        end
    end

    Players.PlayerAdded:Connect(function(v)
        task.spawn(CreateESP, v)
    end)

    Players.PlayerRemoving:Connect(function(v)
        if ScreenGui:FindFirstChild(v.Name) then
            ScreenGui[v.Name]:Destroy()
        end
    end)
end
