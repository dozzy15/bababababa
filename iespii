local FONT_DIR = "Trapgzz_Fonts"
pcall(function()
    if not isfolder(FONT_DIR) then makefolder(FONT_DIR) end
    if not isfolder(FONT_DIR .. "/assets") then makefolder(FONT_DIR .. "/assets") end
    if not isfolder(FONT_DIR .. "/fonts") then makefolder(FONT_DIR .. "/fonts") end
end)

local CustomFonts = {}

local function RegisterFont(Name, Weight, Style, Asset)
    local ok, result = pcall(function()
        local assetPath = FONT_DIR .. "/assets/" .. Asset.Id
        if isfile(assetPath) then
            pcall(delfile, assetPath)
        end
        writefile(assetPath, Asset.Font)

        local Data = {
            name = Name,
            faces = {{
                Name = "Normal",
                weight = Weight,
                style = Style,
                assetId = getcustomasset(assetPath),
            }},
        }

        local fontPath = FONT_DIR .. "/fonts/" .. Name .. ".font"
        writefile(fontPath, HttpService:JSONEncode(Data))
        return getcustomasset(fontPath)
    end)

    if ok and result then
        return result
    end
    warn("[Fonts] Failed: " .. tostring(Name))
    return nil
end

