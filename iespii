-- Misma lógica que bronx.lol
local function ResolveFont(state)
    if state == "Pixel" or state == "Plex" or state == "Minecraftia" or state == "Verdana" then
        return CustomFonts[state] or Enum.Font.Code
    end
    return Enum.Font[state] or Enum.Font.Code
end

local function ApplyFont(label, font)
    if not label or not font then return end
    if typeof(font) == "EnumItem" then
        label.Font = font          -- nativa
    else
        label.FontFace = font      -- custom
    end
end

